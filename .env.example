# ScoutAI Environment Configuration
# Default uses local SQLite for instant zero-dependency development
# To use PostgreSQL (e.g., local PostgreSQL or Supabase):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/scoutai
DATABASE_URL=sqlite:///./scoutai.db

# Storage directory for media assets, frames, and extracted keypoints
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=524288000  # 500 MB

# Application settings
APP_NAME=ScoutAI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
